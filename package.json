{
  "name": "@tier0/dsh-mcp",
  "version": "0.1.3",
  "description": "Connect DeepSeek Harness to Tier0 workspaces through MCP.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1 || 0.2.2-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1 || 0.2.2-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FREEZONEX/Tier0-dsh-mcp.git"
  },
  "homepage": "https://github.com/FREEZONEX/Tier0-dsh-mcp#readme",
  "bugs": {
    "url": "https://github.com/FREEZONEX/Tier0-dsh-mcp/issues"
  },
  "author": "FREEZONEX",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "tier0",
    "mcp",
    "industrial-data"
  ]
}
